{
  "name": "@ile_labs/ckb-msig",
  "version": "0.0.1",
  "description": "Check, merge and convert CKB multisig signatures between ckb-cli, Neuron and CCC.",
  "keywords": [
    "ckb",
    "nervos",
    "multisig",
    "ckb-cli",
    "neuron",
    "ccc",
    "cli"
  ],
  "homepage": "https://github.com/ILE-Labs/ckb-msig#readme",
  "bugs": {
    "url": "https://github.com/ILE-Labs/ckb-msig/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ILE-Labs/ckb-msig.git"
  },
  "license": "MIT",
  "author": "Steven Hert",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ckb-msig": "lib/cli/main.js"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "fixtures:fetch": "node scripts/fetch-fixtures.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ckb-ccc/core": "1.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
